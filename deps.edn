{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj). This
 ;; repo is standalone (forkable outside the workspace); the :local/root
 ;; paths only resolve inside the monorepo checkout — a standalone fork
 ;; should override them with git coordinates.
 ;;
 ;; io.github.kotoba-lang/labor is this vertical's own bespoke domain
 ;; capability library (contracts, timesheets, wages, payroll) -- see
 ;; docs/adr/0001-architecture.md Decision 9. This is the THIRD
 ;; capability-library-wrapping vertical in this fleet, after
 ;; retailops/4711 (kotoba-lang/retail) and freightops/4920
 ;; (kotoba-lang/logistics).
 :deps {;; jp-go-dds: デジタル庁デザインシステム(DADS) -- this workspace's BASE
        ;; design system (CLAUDE.md, repo-wide mandatory 2026-08-05). The
        ;; operator console is styled through `jp-go-dds.skin/dds+skin`,
        ;; the compat skin written FOR these cloud-itonami consoles: it
        ;; restyles the existing semantic markup + small class vocabulary
        ;; (.card/.badge/.tag/.ok/.warn/.err/.critical/.muted/.amt) via
        ;; CSS only, so no markup was reshaped to adopt it.
        io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/labor
        {:local/root "../../kotoba-lang/labor"}
        ;; langchain-store: the shared langchain.db store seam (EDN-blob
        ;; codec + identity schema + event-log helpers) that ~190 actors
        ;; hand-roll; domesticops.store is an adopter (ADR-2607141600).
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "domesticops.sim"]}
  ;; clojure -M:dev:render-html  -> RUN the actor and render
  ;; docs/samples/operator-console.html from the real run output.
  ;; Throws (and writes nothing) if the run produces zero hard governor
  ;; holds. Pass a path to render somewhere else.
  :render-html {:main-opts ["-m" "domesticops.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
